# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5001
FLASK_ENV=production

# ── Embedding Model ──────────────────────────────────────────────────────────
# all-MiniLM-L6-v2 (fast, default) | all-MiniLM-L12-v2 | all-mpnet-base-v2
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Supabase Storage (used by storage-based ingest) ──────────────────────────
# FastAPI uses these credentials to download ZIP archives uploaded by Node.js
# and to delete them after successful indexing.
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_STORAGE_BUCKET=codemap-projects

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins. Leave empty for local dev defaults.
# Production: set to your Node backend's Render URL
# ALLOWED_ORIGINS=https://your-backend.onrender.com

# ── Timeouts (seconds) ──────────────────────────────────────────────────────
# RAG_REQUEST_TIMEOUT=120
# INGEST_TIMEOUT=300
# EMBED_TIMEOUT=60
