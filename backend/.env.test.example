# Test Environment Configuration
# Copy this to .env.test and update with your test database credentials

# Database (Use a separate test database!)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=your_test_user
DB_PASSWORD=your_test_password
DB_DATABASE=codemap_test

# JWT Secrets (can use same as development)
JWT_SECRET=your-jwt-secret-key-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key-here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OAuth Configuration (not required for most tests)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
