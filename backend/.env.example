# Database Configuration
SUPABASE_URI=postgresql://user:password@localhost:5432/codemap

# Server Configuration
PORT=5000

# JWT Configuration
JWT_ACCESS_SECRET=your-secret-access-key-change-this-in-production
JWT_REFRESH_SECRET=your-secret-refresh-key-change-this-in-production

# Google OAuth (Optional - only needed for Google authentication)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth (Optional - only needed for GitHub authentication)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
